// ==============================================================================
// SokoKuu TZ — Canonical Prisma Schema (PostgreSQL 16 + PostGIS 3.4)
// Preserves all blueprint V1–V10 models, enums, integer TZS/Quarter-Quanta,
// plus business_branches, idempotency_keys, refresh_sessions, and domain_outbox_events.
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// Domain Enums
// ------------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  WHOLESALER
  RETAILER
  CONSUMER
  DRIVER
  SUPPLIER
  SALES_STAFF

  @@map("user_role")
}

enum BusinessTier {
  WHOLESALE
  RETAIL_DUKA
  HYBRID_STORE
  MANUFACTURER_SUPPLIER

  @@map("business_tier")
}

enum OrderChannel {
  RETAIL_MARKETPLACE
  SUPPLIER_TO_WHOLESALER

  @@map("order_channel")
}

enum SupplierStockMovementType {
  FACTORY_PRODUCTION
  WAREHOUSE_STOCK_IN
  ORDER_RESERVED
  ORDER_FINALIZED
  STOCK_ADJUSTMENT

  @@map("supplier_stock_movement_type")
}

enum PackagingUnit {
  CARTON
  DOZEN
  PACK
  UNIT
  SACK_50KG
  SACK_25KG
  QUARTER_KILO_LITRE
  HALF_KILO_LITRE
  THREE_QUARTER_KILO
  SINGLE_KILO_LITRE

  @@map("packaging_unit")
}

enum OrderStatus {
  PLACED
  DISPATCHED
  DELIVERED
  CANCELLED
  DISPUTED

  @@map("order_status")
}

enum OrderOrigin {
  PWA_ONLINE
  PWA_IDB_SYNC
  NEXTSMS_INBOUND
  POS_WALKIN

  @@map("order_origin")
}

enum OrderMode {
  INSTANT
  SCHEDULED

  @@map("order_mode")
}

enum LedgerVerificationStatus {
  PENDING
  WAITING
  BUYER_CONFIRMED
  DRIVER_CONFIRMED
  SUCCESSFUL
  DISPUTED

  @@map("ledger_verification_status")
}

enum LeadStatus {
  PROSPECT
  CONVERTED
  ARCHIVED

  @@map("lead_status")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD_LETTER

  @@map("outbox_status")
}

enum SystemUnitCategory {
  WEIGHT
  VOLUME
  PACKAGING

  @@map("system_unit_category")
}

enum StandardPricingProfileType {
  RETAIL
  WHOLESALE
  REGIONAL
  PROMOTIONAL

  @@map("standard_pricing_profile_type")
}

enum PricingChannel {
  RETAIL
  WHOLESALE
  REGIONAL
  PROMOTIONAL

  @@map("pricing_channel")
}

// ------------------------------------------------------------------------------
// 1. Users & Rotating Refresh Sessions
// ------------------------------------------------------------------------------

model User {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneE164       String   @unique @map("phone_e164") @db.VarChar(16)
  fullName        String   @map("full_name") @db.VarChar(150)
  passwordHash    String   @map("password_hash") @db.VarChar(255)
  role              UserRole
  preferredLocale   String   @default("sw") @map("preferred_locale") @db.VarChar(5)
  preferredLanguage String   @default("sw") @map("preferred_language") @db.VarChar(5)
  smsHmacSecret     String   @map("sms_hmac_secret") @db.VarChar(128)
  isActive        Boolean  @default(true) @map("is_active")
  version         BigInt   @default(0)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  ownedMerchants       BusinessProfile[]     @relation("MerchantOwner")
  buyerOrders          Order[]               @relation("OrderBuyer")
  driverOrders         Order[]               @relation("OrderDriver")
  driverLedgers        CashDeliveryLedger[]  @relation("LedgerDriver")
  eodDriverBatches     EodSettlementBatch[]  @relation("EodDriver")
  eodSettledBatches    EodSettlementBatch[]  @relation("EodSettler")
  webPushSubscriptions WebPushSubscription[]
  notifications        UserNotification[]
  supplierPurchaseReceipts SupplierPurchaseReceipt[]
  refreshSessions      RefreshSession[]
  securityAuditLogs    SecurityAuditLog[]

  @@index([role, isActive], map: "idx_users_role_active")
  @@map("users")
}

model RefreshSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId], map: "idx_refresh_sessions_user_family")
  @@map("refresh_sessions")
}

// ------------------------------------------------------------------------------
// 2. Multi-Tenant Merchants (business_profiles) & Branches
// ------------------------------------------------------------------------------

model BusinessProfile {
  id                   String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId          String                                @map("owner_user_id") @db.Uuid
  smsShortCode         String                                @unique @map("sms_short_code") @db.VarChar(10)
  businessName         String                                @map("business_name") @db.VarChar(180)
  tier                 BusinessTier
  streetAddress        String                                @map("street_address")
  ward                 String                                @db.VarChar(100)
  district             String                                @db.VarChar(100)
  latitude             Decimal                               @db.Decimal(9, 6)
  longitude            Decimal                               @db.Decimal(9, 6)
  location             Unsupported("geography(Point, 4326)")?
  logoCdnUrl           String?                               @map("logo_cdn_url")
  isOpen               Boolean                               @default(true) @map("is_open")
  isPlatformManaged    Boolean                               @default(true) @map("is_platform_managed")
  /// Explicit Merchant consent for Super Admin helpdesk to receive/route its orders.
  allowAdminReceive    Boolean                               @default(false) @map("allow_admin_receive")
  offersFreeDelivery   Boolean                               @default(false) @map("offers_free_delivery")
  isFreeDeliveryEnabled Boolean                              @default(false) @map("is_free_delivery_enabled")
  freeDeliveryMinOrderTzs BigInt                             @default(0) @map("free_delivery_min_order_tzs")
  standardDeliveryFeeTzs BigInt                              @default(0) @map("standard_delivery_fee_tzs")
  deliveryCoverageRegions String[]                           @default([]) @map("delivery_coverage_regions")
  geospatialMapEnabled Boolean                               @default(false) @map("geospatial_map_enabled")
  wardName             String?                               @map("ward_name") @db.VarChar(140)
  streetLandmark       String?                               @map("street_landmark") @db.VarChar(240)
  routeWaypoints       Json                                  @default("[]") @map("route_waypoints")
  accountStatus        String                                @default("ACTIVE") @map("account_status") @db.VarChar(32)
  suspensionReason     String?                               @map("suspension_reason")
  suspendedAt          DateTime?                             @map("suspended_at") @db.Timestamptz(6)
  suspendedByAdminId   String?                               @map("suspended_by_admin_id") @db.Uuid
  version              BigInt                                @default(0)
  createdAt            DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner                  User                      @relation("MerchantOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  branches               BusinessBranch[]
  products               Product[]
  clonedProducts         MerchantClonedProduct[]
  sellerOrders           Order[]                   @relation("OrderSeller")
  dispatchAuditTraces    OrderDispatchAuditTrace[]
  convertedFromLeads     SokoLead[]
  posSaleReceipts        PosSaleReceipt[]
  eodSettlementBatches   EodSettlementBatch[]
  financialAuditLogs     FinancialAuditLog[]
  unitPricingOverrides   MerchantUnitPricingOverride[]
  priceAuditLogs         MerchantPriceAuditLog[]
  externalPurchaseReceipts ExternalPurchaseReceipt[]
  supplierCatalogListings  SupplierCatalogListing[]
  supplierStockMovements   SupplierStockMovement[]
  supplierPurchaseReceipts SupplierPurchaseReceipt[]
  notifications            UserNotification[]

  @@index([id, isPlatformManaged], map: "idx_business_platform_managed")
  @@map("business_profiles")
}

model BusinessBranch {
  id           String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String                                @map("business_id") @db.Uuid
  branchCode   String                                @map("branch_code") @db.VarChar(24)
  branchName   String                                @map("branch_name") @db.VarChar(160)
  streetAddress String                               @map("street_address")
  ward         String                                @db.VarChar(100)
  district     String                                @db.VarChar(100)
  latitude     Decimal                               @db.Decimal(9, 6)
  longitude    Decimal                               @db.Decimal(9, 6)
  location     Unsupported("geography(Point, 4326)")?
  isPrimary    Boolean                               @default(false) @map("is_primary")
  isActive     Boolean                               @default(true) @map("is_active")
  version      BigInt                                @default(0)
  createdAt    DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  business BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, branchCode], map: "uq_business_branch_code")
  @@index([businessId, isActive], map: "idx_business_branches_active")
  @@map("business_branches")
}

// ------------------------------------------------------------------------------
// 3. Global Master Catalog, Categories & Merchant Shelf Clones
// ------------------------------------------------------------------------------

model SokoCatalogCategory {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryCode       String   @unique @map("category_code") @db.VarChar(64)
  nameSw             String   @map("name_sw") @db.VarChar(120)
  nameEn             String   @map("name_en") @db.VarChar(120)
  imagekitFolderPath String   @map("imagekit_folder_path") @db.VarChar(200)
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("soko_catalog_categories")
}

model SokoGlobalCatalog {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  canonicalSku         String   @unique @map("canonical_sku") @db.VarChar(32)
  fixedNameSw          String   @map("fixed_name_sw") @db.VarChar(200)
  fixedNameEn          String   @map("fixed_name_en") @db.VarChar(200)
  categoryCode         String   @map("category_code") @db.VarChar(64)
  staticImageUrl       String   @map("static_image_url")
  imagekitCdnUrl       String   @map("imagekit_cdn_url")
  baseQuantumUnit      String   @default("QUANTA_250G") @map("base_quantum_unit") @db.VarChar(32)
  clonedByStoresCount  BigInt   @default(0) @map("cloned_by_stores_count")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchantClones MerchantClonedProduct[]
  sellerProducts Product[]
  productUnits   GlobalProductUnit[]
  standardPrices GlobalCatalogStandardPrice[]
  pricingTemplateAttachments GlobalCatalogPricingTemplate[]
  supplierListings SupplierCatalogListing[]
  supplierStockMovements SupplierStockMovement[]
  supplierPurchaseReceipts SupplierPurchaseReceipt[]

  @@index([categoryCode, isActive], map: "idx_global_catalog_active")
  @@map("soko_global_catalog")
}

model MerchantClonedProduct {
  id                                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  retailerBusinessId                 String   @map("retailer_business_id") @db.Uuid
  globalCatalogId                    String   @map("global_catalog_id") @db.Uuid
  availableQuantaStock               Int      @default(0) @map("available_quanta_stock")
  lowStockThresholdQuanta            Int      @default(20) @map("low_stock_threshold_quanta")
  unitPriceTzs                       BigInt   @default(0) @map("unit_price_tzs")
  imagekitCdnUrl                     String   @default("") @map("imagekit_cdn_url")
  inventoryValueTzs                  BigInt   @default(0) @map("inventory_value_tzs")
  lastBuyingPricePerQuantumTzs       BigInt   @default(0) @map("last_buying_price_per_quantum_tzs")
  weightedAvgBuyingCostPerQuantumTzs BigInt   @default(0) @map("weighted_avg_buying_cost_per_quantum_tzs")
  buyingPriceEstablished             Boolean   @default(false) @map("buying_price_established")
  lastAgreedPurchasePriceTzs         BigInt?   @map("last_agreed_purchase_price_tzs")
  isPublishedToMarket                Boolean   @default(false) @map("is_published_to_market")
  isActiveForSale                    Boolean   @default(true) @map("is_active_for_sale")
  isActive                           Boolean   @default(true) @map("is_active")
  deletedAt                          DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt                          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant                 BusinessProfile               @relation(fields: [retailerBusinessId], references: [id], onDelete: Cascade)
  globalCatalog            SokoGlobalCatalog             @relation(fields: [globalCatalogId], references: [id], onDelete: Restrict)
  unitPricingOverrides     MerchantUnitPricingOverride[]
  priceAuditLogs           MerchantPriceAuditLog[]
  externalPurchaseReceipts ExternalPurchaseReceipt[]

  @@unique([retailerBusinessId, globalCatalogId], map: "uq_merchant_global_clone")
  @@index([retailerBusinessId, isActive], map: "idx_merchant_clones_business_active")
  @@map("merchant_cloned_products")
}

// ------------------------------------------------------------------------------
// 4. Merchant Products, Volume Price Tiers & Bulk Deconstruction Logs
// ------------------------------------------------------------------------------

model Product {
  id                         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sellerBusinessId           String        @map("seller_business_id") @db.Uuid
  globalCatalogId            String?       @map("global_catalog_id") @db.Uuid
  smsItemCode                String        @map("sms_item_code") @db.VarChar(8)
  nameEn                     String        @map("name_en") @db.VarChar(200)
  nameSw                     String        @map("name_sw") @db.VarChar(200)
  cartonUnits                Int           @default(24) @map("carton_units")
  cartonPriceTzs             BigInt        @map("carton_price_tzs")
  dozenPriceTzs              BigInt        @map("dozen_price_tzs")
  packPriceTzs               BigInt        @map("pack_price_tzs")
  unitPriceTzs               BigInt        @map("unit_price_tzs")
  baseUnitStock              Int           @default(0) @map("base_unit_stock")
  baseQuarterQuantaStock     Int           @default(0) @map("base_quarter_quanta_stock")
  sealedBulkPackagesStock    Int           @default(0) @map("sealed_bulk_packages_stock")
  sealedParentUnitType       PackagingUnit @default(SACK_50KG) @map("sealed_parent_unit_type")
  quantaPerSealedPackage     Int           @default(200) @map("quanta_per_sealed_package")
  wholesaleMinUnitsThreshold Int           @default(1) @map("wholesale_min_units_threshold")
  wholesaleMinWeightKg       Decimal       @default(1.00) @map("wholesale_min_weight_kg") @db.Decimal(8, 2)
  wholesaleMinQuarterQuanta  Int?          @map("wholesale_min_quarter_quanta")
  lowStockThresholdQuanta    Int           @default(20) @map("low_stock_threshold_quanta")
  isPublishedToMarket        Boolean       @default(true) @map("is_published_to_market")
  isActive                   Boolean       @default(true) @map("is_active")
  version                    BigInt        @default(0)
  createdAt                  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller             BusinessProfile              @relation(fields: [sellerBusinessId], references: [id], onDelete: Restrict)
  globalCatalog      SokoGlobalCatalog?           @relation(fields: [globalCatalogId], references: [id], onDelete: SetNull)
  priceTiers         ProductPriceTier[]
  customUnits        MerchantCustomUnit[]
  orderItems         OrderItem[]
  deconstructionLogs InventoryDeconstructionLog[]
  posSaleReceipts    PosSaleReceipt[]
  supplierStockMovements SupplierStockMovement[]
  supplierPurchaseReceipts SupplierPurchaseReceipt[]

  @@unique([sellerBusinessId, smsItemCode], map: "uq_seller_sms_item")
  @@map("products")
}

model MerchantCustomUnit {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  unitCode             String   @map("unit_code") @db.VarChar(32)
  unitLabel            String   @map("unit_label") @db.VarChar(64)
  baseKg               Decimal  @map("base_kg") @db.Decimal(8, 2)
  quarterQuantaPerUnit Int      @map("quarter_quanta_per_unit")
  priceTzs             BigInt   @map("price_tzs")
  isWholesaleTier      Boolean  @default(false) @map("is_wholesale_tier")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, unitCode], map: "uq_product_custom_unit_code")
  @@map("merchant_custom_units")
}

model ProductPriceTier {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId            String        @map("product_id") @db.Uuid
  unitType             PackagingUnit @map("unit_type")
  quarterQuantaPerUnit Int           @map("quarter_quanta_per_unit")
  priceTzs             BigInt        @map("price_tzs")
  isWholesaleTier      Boolean       @default(false) @map("is_wholesale_tier")
  isActive             Boolean       @default(true) @map("is_active")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, unitType, isWholesaleTier], map: "uq_product_unit_wholesale_flag")
  @@index([productId, unitType, isWholesaleTier], map: "idx_price_tiers_lookup")
  @@map("product_price_tiers")
}

model InventoryDeconstructionLog {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId             String        @map("product_id") @db.Uuid
  parentUnitType        PackagingUnit @map("parent_unit_type")
  bulkPackagesBroken    Int           @map("bulk_packages_broken")
  creditedQuarterQuanta Int           @map("credited_quarter_quanta")
  looseQuantaBefore     Int           @map("loose_quanta_before")
  looseQuantaAfter      Int           @map("loose_quanta_after")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt(sort: Desc)], map: "idx_deconstruction_product_time")
  @@map("inventory_deconstruction_logs")
}

// ------------------------------------------------------------------------------
// 5. Orders, Line Items, Dual-PIN Cash Ledgers & Routing Audit Traces
// ------------------------------------------------------------------------------

model Order {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderRef              String      @unique @map("order_ref") @db.Char(8)
  buyerUserId           String      @map("buyer_user_id") @db.Uuid
  sellerBusinessId      String      @map("seller_business_id") @db.Uuid
  driverUserId          String?     @map("driver_user_id") @db.Uuid
  status                OrderStatus @default(PLACED)
  originChannel         OrderOrigin  @default(PWA_ONLINE) @map("origin_channel")
  orderChannel          OrderChannel @default(RETAIL_MARKETPLACE) @map("order_channel")
  orderMode             OrderMode    @default(INSTANT) @map("order_mode")
  routingTargetPipeline String       @default("SUPER_ADMIN_HELPDESK_PIPELINE") @map("routing_target_pipeline") @db.VarChar(64)
  rawSmsPayload         String?     @map("raw_sms_payload") @db.VarChar(160)
  expectedTotalTzs      BigInt      @map("expected_total_tzs")
  deliveryFeeTzs        BigInt      @default(0) @map("delivery_fee_tzs")
  paymentMethod         String      @default("CASH") @map("payment_method") @db.VarChar(24)
  paidAmountTzs         BigInt      @default(0) @map("paid_amount_tzs")
  version               BigInt      @default(0)
  placedAt              DateTime    @default(now()) @map("placed_at") @db.Timestamptz(6)
  dispatchedAt          DateTime?   @map("dispatched_at") @db.Timestamptz(6)
  deliveredAt           DateTime?   @map("delivered_at") @db.Timestamptz(6)
  cancelledAt           DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason    String?     @map("cancellation_reason")
  scheduledDeliveryDate DateTime?   @map("scheduled_delivery_date") @db.Date
  deliveryZoneWard      String?     @map("delivery_zone_ward") @db.VarChar(140)

  buyer              User                      @relation("OrderBuyer", fields: [buyerUserId], references: [id], onDelete: Restrict)
  seller             BusinessProfile           @relation("OrderSeller", fields: [sellerBusinessId], references: [id], onDelete: Restrict)
  driver             User?                     @relation("OrderDriver", fields: [driverUserId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  cashLedger         CashDeliveryLedger?
  auditTraces        OrderDispatchAuditTrace[]
  financialAuditLogs FinancialAuditLog[]
  nextSmsInboundLogs NextSmsInboundLog[]

  @@index([buyerUserId, status], map: "idx_orders_buyer_status")
  @@index([sellerBusinessId, status], map: "idx_orders_seller_status")
  @@index([driverUserId, status], map: "idx_orders_driver_active")
  @@map("orders")
}

model OrderItem {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId                String        @map("order_id") @db.Uuid
  productId              String        @map("product_id") @db.Uuid
  unitType               PackagingUnit @map("unit_type")
  quantity               Int
  baseUnitsTotal         Int           @map("base_units_total")
  orderChannel           OrderChannel  @default(RETAIL_MARKETPLACE) @map("order_channel")
  unitPriceTzs           BigInt        @map("unit_price_tzs")
  lineTotalTzs           BigInt        @map("line_total_tzs")
  isWholesaleTierApplied Boolean       @default(false) @map("is_wholesale_tier_applied")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model CashDeliveryLedger {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId               String                   @unique @map("order_id") @db.Uuid
  driverUserId          String?                  @map("driver_user_id") @db.Uuid
  orderChannel          OrderChannel             @default(RETAIL_MARKETPLACE) @map("order_channel")
  oneTimeQrToken        String?                  @unique @map("one_time_qr_token") @db.VarChar(255)
  qrTokenExpiresAt      DateTime?                @map("qr_token_expires_at") @db.Timestamptz(6)
  qrTokenSignature      String?                  @map("qr_token_signature") @db.VarChar(128)
  isQrTokenConsumed     Boolean                  @default(false) @map("is_qr_token_consumed")
  buyerConfirmationPin  String                   @map("buyer_confirmation_pin") @db.VarChar(128)
  driverConfirmationPin String                   @map("driver_confirmation_pin") @db.VarChar(128)
  isBuyerConfirmed      Boolean                  @default(false) @map("is_buyer_confirmed")
  isDriverConfirmed     Boolean                  @default(false) @map("is_driver_confirmed")
  expectedCashAmount    BigInt                   @map("expected_cash_amount")
  collectedCashAmount   BigInt                   @default(0) @map("collected_cash_amount")
  paymentMethod         String                   @default("CASH") @map("payment_method") @db.VarChar(24)
