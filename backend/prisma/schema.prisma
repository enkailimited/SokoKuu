/// Standalone, reusable Admin-controlled pricing object. It is NOT owned by a
/// single product: Admin creates it once and attaches it to any Global Catalog
/// SKU through GlobalCatalogPricingTemplate.
model StandardPricingTemplate {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateName       String         @map("template_name") @db.VarChar(120)
  systemUnitId       String         @map("system_unit_id") @db.Uuid
  packItemCount      Int            @default(1) @map("pack_item_count")
  unitMeasureValue   String         @map("unit_measure_value") @db.VarChar(24)
  quarterQuantaTotal Int            @map("quarter_quanta_total")
  pricingChannel     PricingChannel @map("pricing_channel")
  standardPriceTzs   BigInt         @map("standard_price_tzs")
  version            Int            @default(1)
  isActive           Boolean        @default(true) @map("is_active")
  createdByAdminId   String?        @map("created_by_admin_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  systemUnit  SystemUnit                    @relation(fields: [systemUnitId], references: [id], onDelete: Restrict)
  attachments GlobalCatalogPricingTemplate[]

  @@index([pricingChannel, isActive], map: "idx_standard_pricing_templates_channel")
  @@map("standard_pricing_templates")
}

/// Join table linking reusable Pricing Templates to Global Catalog products.
/// The old global_catalog_standard_prices rows remain untouched for backwards
/// compatibility with existing Merchant overrides and historical orders.
model GlobalCatalogPricingTemplate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  globalCatalogId String  @map("global_catalog_id") @db.Uuid
  templateId     String   @map("template_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  globalCatalog SokoGlobalCatalog     @relation(fields: [globalCatalogId], references: [id], onDelete: Cascade)
  template      StandardPricingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([globalCatalogId, templateId], map: "uq_global_catalog_pricing_template")
  @@index([globalCatalogId], map: "idx_gc_pricing_templates_catalog")
  @@map("global_catalog_pricing_templates")
}

model MerchantUnitPricingOverride {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clonedProductId          String   @map("cloned_product_id") @db.Uuid
  businessId               String   @map("business_id") @db.Uuid
  globalProductUnitId      String   @map("global_product_unit_id") @db.Uuid
  standardPriceId          String?  @map("standard_price_id") @db.Uuid
  standardPriceVersion     Int?     @map("standard_price_version")
  selectedStandardPriceTzs BigInt?  @map("selected_standard_price_tzs")
  amendedSellingPriceTzs   BigInt?  @map("amended_selling_price_tzs")
  effectiveSellingPriceTzs BigInt   @map("effective_selling_price_tzs")
  isOverridden             Boolean  @default(false) @map("is_overridden")
  isActive                 Boolean  @default(true) @map("is_active")
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  clonedProduct     MerchantClonedProduct       @relation(fields: [clonedProductId], references: [id], onDelete: Cascade)
  business          BusinessProfile             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  globalProductUnit GlobalProductUnit           @relation(fields: [globalProductUnitId], references: [id], onDelete: Restrict)
  standardPrice     GlobalCatalogStandardPrice? @relation(fields: [standardPriceId], references: [id], onDelete: SetNull)

  @@unique([clonedProductId, globalProductUnitId], map: "uq_merchant_cloned_unit_override")
  @@index([businessId, isActive], map: "idx_merchant_unit_overrides_business")
  @@map("merchant_unit_pricing_overrides")
}

model MerchantPriceAuditLog {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId           String   @map("business_id") @db.Uuid
  clonedProductId      String   @map("cloned_product_id") @db.Uuid
  globalProductUnitId  String   @map("global_product_unit_id") @db.Uuid
  actorUserId          String   @map("actor_user_id") @db.Uuid
  action               String   @db.VarChar(32)
  previousPriceTzs     BigInt?  @map("previous_price_tzs")
  newPriceTzs          BigInt   @map("new_price_tzs")
  standardPriceId      String?  @map("standard_price_id") @db.Uuid
  standardPriceVersion Int?     @map("standard_price_version")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  business      BusinessProfile       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clonedProduct MerchantClonedProduct @relation(fields: [clonedProductId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt(sort: Desc)], map: "idx_merchant_price_audit_biz_time")
  @@map("merchant_price_audit_logs")
}

model ExternalPurchaseReceipt {
  id                                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId                         String    @map("business_id") @db.Uuid
  clonedProductId                    String    @map("cloned_product_id") @db.Uuid
  globalProductUnitId                String?   @map("global_product_unit_id") @db.Uuid
  stockSource                        String    @default("EXTERNAL_SUPPLIER") @map("stock_source") @db.VarChar(32)
  supplierName                       String    @map("supplier_name") @db.VarChar(180)
  supplierReference                  String?   @map("supplier_reference") @db.VarChar(80)
  receiptStatus                      String    @default("GOODS_RECEIVED") @map("receipt_status") @db.VarChar(32)
  quantityUnits                      Int       @map("quantity_units")
  quarterQuantaPerUnit               Int       @map("quarter_quanta_per_unit")
  receivedQuanta                     Int       @map("received_quanta")
  agreedTotalCostTzs                 BigInt    @map("agreed_total_cost_tzs")
  costPerQuantumTzs                  BigInt    @map("cost_per_quantum_tzs")
  prevWeightedAvgCostPerQuantumTzs   BigInt    @default(0) @map("prev_weighted_avg_cost_per_quantum_tzs")
  newWeightedAvgCostPerQuantumTzs    BigInt    @default(0) @map("new_weighted_avg_cost_per_quantum_tzs")
  recordedByUserId                   String    @map("recorded_by_user_id") @db.Uuid
  receivedAt                         DateTime? @map("received_at") @db.Timestamptz(6)
  createdAt                          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  business          BusinessProfile       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clonedProduct     MerchantClonedProduct @relation(fields: [clonedProductId], references: [id], onDelete: Cascade)
  globalProductUnit GlobalProductUnit?    @relation(fields: [globalProductUnitId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt(sort: Desc)], map: "idx_external_purchase_receipts_biz_time")
  @@map("external_purchase_receipts")
}

// ------------------------------------------------------------------------------
// 14. Supplier (Manufacturer / Distributor) Warehouse & B2B Marketplace
// ------------------------------------------------------------------------------

model SupplierCatalogListing {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierBusinessId    String   @map("supplier_business_id") @db.Uuid
  globalCatalogId       String   @map("global_catalog_id") @db.Uuid
  systemUnitId          String   @map("system_unit_id") @db.Uuid
  supplierBulkPriceTzs  BigInt   @map("supplier_bulk_price_tzs")
  minOrderQuantity      Int      @default(1) @map("min_order_quantity")
  isPublishedToMarket   Boolean  @default(true) @map("is_published_to_market")
  imagekitCdnUrl        String   @default("") @map("imagekit_cdn_url")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier      BusinessProfile   @relation(fields: [supplierBusinessId], references: [id], onDelete: Cascade)
  globalCatalog SokoGlobalCatalog @relation(fields: [globalCatalogId], references: [id], onDelete: Restrict)
  systemUnit    SystemUnit        @relation(fields: [systemUnitId], references: [id], onDelete: Restrict)

  @@unique([supplierBusinessId, globalCatalogId, systemUnitId], map: "uq_supplier_listing_unit")
  @@index([isPublishedToMarket, globalCatalogId], map: "idx_supplier_listing_market")
  @@map("supplier_catalog_listings")
}

model SupplierStockMovement {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierBusinessId String                    @map("supplier_business_id") @db.Uuid
  productId          String                    @map("product_id") @db.Uuid
  globalCatalogId    String                    @map("global_catalog_id") @db.Uuid
  movementType       SupplierStockMovementType @map("movement_type")
  quantityQuanta     Int                       @map("quantity_quanta")
  referenceType      String                    @map("reference_type") @db.VarChar(32)
  referenceId        String?                   @map("reference_id") @db.VarChar(80)
  recordedByUserId   String?                   @map("recorded_by_user_id") @db.Uuid
  note               String?
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  supplier      BusinessProfile   @relation(fields: [supplierBusinessId], references: [id], onDelete: Cascade)
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  globalCatalog SokoGlobalCatalog @relation(fields: [globalCatalogId], references: [id], onDelete: Restrict)

  @@index([supplierBusinessId, createdAt(sort: Desc)], map: "idx_supplier_stock_movement_biz_time")
  @@index([productId, createdAt(sort: Desc)], map: "idx_supplier_stock_movement_product_time")
  @@map("supplier_stock_movements")
}

/// Supplier-owned manual purchase receipt. Suppliers do not use Merchant clone
/// receipts because their warehouse SKUs live directly in `products`.
model SupplierPurchaseReceipt {
  id                               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierBusinessId               String    @map("supplier_business_id") @db.Uuid
  productId                        String    @map("product_id") @db.Uuid
  globalCatalogId                  String    @map("global_catalog_id") @db.Uuid
  globalProductUnitId              String?   @map("global_product_unit_id") @db.Uuid
  supplierName                     String    @map("supplier_name") @db.VarChar(180)
  supplierReference                String?   @map("supplier_reference") @db.VarChar(80)
  receiptStatus                    String    @default("GOODS_RECEIVED") @map("receipt_status") @db.VarChar(32)
  quantityUnits                    Int       @map("quantity_units")
  quarterQuantaPerUnit             Int       @map("quarter_quanta_per_unit")
  receivedQuanta                   Int       @map("received_quanta")
  agreedTotalCostTzs               BigInt    @map("agreed_total_cost_tzs")
  costPerQuantumTzs                BigInt    @map("cost_per_quantum_tzs")
  previousWeightedAvgCostPerQuantumTzs BigInt @default(0) @map("previous_weighted_avg_cost_per_quantum_tzs")
  newWeightedAvgCostPerQuantumTzs   BigInt    @default(0) @map("new_weighted_avg_cost_per_quantum_tzs")
  recordedByUserId                 String    @map("recorded_by_user_id") @db.Uuid
  receivedAt                       DateTime? @map("received_at") @db.Timestamptz(6)
  createdAt                        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  supplier        BusinessProfile   @relation(fields: [supplierBusinessId], references: [id], onDelete: Cascade)
  product         Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  globalCatalog   SokoGlobalCatalog @relation(fields: [globalCatalogId], references: [id], onDelete: Restrict)
  globalProductUnit GlobalProductUnit? @relation(fields: [globalProductUnitId], references: [id], onDelete: SetNull)
  recordedBy      User              @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([supplierBusinessId, createdAt(sort: Desc)], map: "idx_supplier_purchase_receipts_biz_time")
  @@index([productId, createdAt(sort: Desc)], map: "idx_supplier_purchase_receipts_product_time")
  @@map("supplier_purchase_receipts")
}

/// Durable per-user notification inbox. Socket.IO and Web Push are delivery
/// channels only; this table is the source of truth for each role dashboard.
model UserNotification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  businessId String?   @map("business_id") @db.Uuid
  role       UserRole  @map("role")
  eventType  String    @map("event_type") @db.VarChar(100)
  category   String    @default("STANDARD_UPDATE") @map("category") @db.VarChar(64)
  title      String    @db.VarChar(180)
  body       String    @db.VarChar(600)
  deepLink   String?   @map("deep_link") @db.VarChar(255)
  metadata   Json?
  dedupeKey  String?   @map("dedupe_key") @db.VarChar(180)
  isRead     Boolean   @default(false) @map("is_read")
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  business BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey], map: "uq_user_notification_dedupe")
  @@index([userId, isRead, createdAt(sort: Desc)], map: "idx_user_notification_inbox")
  @@index([role, createdAt(sort: Desc)], map: "idx_user_notification_role_time")
  @@index([businessId, createdAt(sort: Desc)], map: "idx_user_notification_business_time")
  @@map("user_notifications")
}
