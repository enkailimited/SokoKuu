# ==============================================================================
# SokoKuu TZ — NestJS Backend Environment Configuration Template
# Never commit real production secrets.
# ==============================================================================

NODE_ENV=development
PORT=8080
TZ=Africa/Dar_es_Salaam
LOG_LEVEL=info

# PostgreSQL 16 + PostGIS 3.4 (SokoKuu Cloud SQL Database Cluster)
DATABASE_URL=postgresql://sokokuu:change_me_in_env@localhost:5432/sokokuu_tz?schema=public

# Redis 7 (Rate Limiting, Token Revocation, Idempotency & Pub/Sub)
REDIS_URL=redis://localhost:6379

# RabbitMQ 3.13 (Transactional Outbox & AFTER_COMMIT Domain Events)
RABBITMQ_URL=amqp://sokokuu:change_me_in_env@localhost:5672

# JWT Authentication Secrets (Minimum 32 characters each)
JWT_ACCESS_SECRET=replace_with_32_plus_char_access_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_32_plus_char_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# NextSMS Inbound Gateway Webhook Secret (Minimum 16 characters)
NEXTSMS_WEBHOOK_SHARED_TOKEN=replace_with_nextsms_gateway_token
SECURITY_ADMIN_ALERT_PHONE=+255700000001

# Web Push VAPID Keys
VAPID_SUBJECT=mailto:ops@sokokuu.tz
VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key

# Strict CORS Origins (Comma-separated, no wildcard with credentials)
# CORS_ORIGINS is the preferred alias; CORS_ALLOWED_ORIGINS is the legacy name.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,https://sokokuu.tz
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,https://sokokuu.tz
